INFERENCE_NETWORK=inference-net

# The NER-only stack (`make up-gliner-only`, CPU-friendly) uses
# docker/compose.gliner-only.yaml — a separate compose project that ignores
# the chat/embed/rerank/asr model vars. Only the NER_* knobs below apply
# in that shape. Defaults for gliner-only are NER_DEVICE=cpu and
# NER_MODEL=gliner-community/gliner_medium-v2.5.
#
# The Rerank-only stack (`make up-rerank-only`, CPU-friendly) uses
# docker/compose.rerank-only.yaml — a separate compose project that
# only honours the RERANK_MODEL / RERANK_USE_FP16 /
# RERANK_HOST_PORT vars. Reached as http://rerank-only:8000/rerank on
# inference-net; speaks the same Jina-shape /rerank contract as the
# full-stack vLLM rerank service.
#
# The CLIP-only stack (`make up-clip-only`, CPU-friendly) uses
# docker/compose.clip-only.yaml — a separate compose project that
# only honours the CLIP_MODEL / CLIP_DEVICE /
# CLIP_HOST_PORT vars. Reached as
# http://clip-only:8000/clip/embed_{image,text} on inference-net.
#
# The Embed-only stack (`make up-embed-only`, CPU-friendly) uses
# docker/compose.embed-only.yaml — a separate compose project that
# only honours the EMBED_MODEL / EMBED_MAX_LENGTH /
# EMBED_HOST_PORT vars. Reached as http://embed-only:8000 on
# inference-net; speaks the same /pooling (task=token_classify) and
# /tokenize contract the full stack's router passes through to the vLLM
# embed backend.
#
# The Diarize-only stack (`make up-diarize-only`, CPU-friendly) uses
# docker/compose.diarize-only.yaml — a separate compose project that only
# honours the DIARIZE_MODEL / DIARIZE_DEVICE / DIARIZE_HOST_PORT vars.
# Reached as http://diarize-only:8000/diarize on inference-net; speaks the
# same multipart /diarize contract as the full-stack diarize service.
#
# The ASR-only stack (`make up-asr-only`, CPU-friendly) uses
# docker/compose.asr-only.yaml — a separate compose project that only honours
# the WHISPER_MODEL / ASR_DEVICE / ASR_HOST_PORT vars. Reached as
# http://asr-only:8000/v1/audio/transcriptions on inference-net; speaks the
# same OpenAI transcription contract as the full-stack asr service (CPU
# openai-whisper instead of vLLM).
#
# The VAD-only stack (`make up-vad-only`, CPU-friendly) uses
# docker/compose.vad-only.yaml — a separate compose project that only honours
# the VAD_MODEL / VAD_DEVICE / VAD_HOST_PORT / VAD_USE_ONNX vars. Reached as
# http://vad-only:8000/vad on inference-net; speaks the same multipart /vad
# contract as the full-stack vad service.

OPENAI_API_KEY=sk-no-key-required
# OPENAI_API_KEY is also used as the LiteLLM master key that gates access
# to the router. Clients must present it as `Authorization: Bearer <key>`.
# ROUTER_HOST_PORT=9000

# Proxy bypass: comma-separated extra hostnames appended to NO_PROXY/no_proxy.
# Must start with a leading comma:
# EXTRA_NO_PROXY=,some-extra-host

# Model selection
# TEXT_MODEL=${TEXT_MODEL}
# VISION_MODEL=${VISION_MODEL}
# EMBED_MODEL=${EMBED_MODEL:-BAAI/bge-m3}
# RERANK_MODEL=${RERANK_MODEL:-BAAI/bge-reranker-v2-m3}
# NER_MODEL=${NER_MODEL:-gliner-community/gliner_large-v2.5}
# CLIP_MODEL=${CLIP_MODEL:-openai/clip-vit-base-patch32}
# WHISPER_MODEL=${WHISPER_MODEL:-openai/whisper-large-v3}
# DIARIZE_MODEL=${DIARIZE_MODEL:-pyannote/speaker-diarization-community-1}   # 4.x default; gated — bundle its weights
# VAD_MODEL=${VAD_MODEL:-silero_vad}   # informational; silero-vad bundles one model

# Optional Hugging Face access / offline mode
# HF_TOKEN=hf_your_token_here
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Chat
# CHAT_CUDA_VISIBLE_DEVICES=0,1
# CHAT_TENSOR_PARALLEL_SIZE=2
# CHAT_GPU_MEMORY_UTILIZATION=0.55
# CHAT_MAX_MODEL_LEN=8192
# CHAT_MAX_NUM_SEQS=8
# CHAT_MAX_NUM_BATCHED_TOKENS=16384
# CHAT_ENFORCE_EAGER=true
# CHAT_ENABLE_PREFIX_CACHING=true
# CHAT_ENABLE_AUTO_TOOL_CHOICE=true     # required for Gemma 4 tool calling (also set CHAT_TOOL_CALL_PARSER)
# CHAT_TOOL_CALL_PARSER=gemma4          # required for Gemma 4 tool calling
# CHAT_REASONING_PARSER=gemma4          # optional: enables thinking traces; can interfere with tool-call parsing
# CHAT_CHAT_TEMPLATE=examples/tool_chat_template_gemma4.jinja
# CHAT_TEMPLATE_CONTENT_FORMAT=openai
# CHAT_DEFAULT_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
# CHAT_LIMIT_MM_PER_PROMPT={"image":4}
# CHAT_CPU_OFFLOAD_GB=4

# Dense / sparse embeddings
# EMBED_CUDA_VISIBLE_DEVICES=1
# EMBED_GPU_MEMORY_UTILIZATION=0.1
# EMBED_RUNNER=pooling
# EMBED_CONVERT=embed
# EMBED_POOLER_TASK=embed                # pins pooling task; required since v0.20 (multitask deprecated)
# EMBED_HF_OVERRIDES={"architectures":["BgeM3EmbeddingModel"]}

# Rerank
# Full-stack vLLM rerank service (CUDA):
# RERANK_CUDA_VISIBLE_DEVICES=1
# RERANK_GPU_MEMORY_UTILIZATION=0.1
# RERANK_RUNNER=pooling
# RERANK_POOLER_TASK=classify            # pins pooling task; required since v0.20 (multitask deprecated)
#
# Rerank-only CPU stack (`make up-rerank-only`):
# RERANK_USE_FP16=false                  # rarely worthwhile on CPU; default false
# RERANK_HOST_PORT=8001                  # host publish port for dev override

# --- embed-only shape ---------------------------------------------------
# CPU bge-m3 sparse-embedding service. Serves /pooling (task=token_classify)
# and /tokenize — the same routes the full stack's router passes through to
# the vLLM embed backend — so docint points SPARSE_API_BASE at either.
EMBED_MODEL=BAAI/bge-m3
EMBED_MAX_LENGTH=8192
# Host port published only by `make up-dev-embed-only`.
EMBED_HOST_PORT=8007

# CLIP image+text embedding tower
# Full-stack vLLM CLIP service (CUDA, routed by LiteLLM at /clip/*):
# CLIP_CUDA_VISIBLE_DEVICES=0
# CLIP_DEVICE=cuda                       # cuda | cpu; default cuda in full stack
#
# CLIP-only CPU stack (`make up-clip-only`):
# CLIP_DEVICE=cpu                        # default cpu in clip-only
# CLIP_HOST_PORT=8002                    # host publish port for dev override

# ASR (Whisper)
# Full-stack vLLM asr service (CUDA):
# ASR_CUDA_VISIBLE_DEVICES=0,1
# ASR_GPU_MEMORY_UTILIZATION=0.15
# VLLM_MAX_AUDIO_CLIP_FILESIZE_MB=200    # vLLM-internal var name; do not rename
#
# ASR-only CPU stack (`make up-asr-only`):
# ASR_DEVICE=cpu                         # default cpu in asr-only
# ASR_HOST_PORT=8005                     # host publish port for dev override

# Voice activity detection (Silero VAD via FastAPI).
# Routed by LiteLLM as a pass-through in the full stack; clients POST multipart
# audio to
#   http://<router>:${ROUTER_HOST_PORT}/vad
# with optional threshold / *_duration_ms form fields — no /v1 prefix, not
# OpenAI-shaped. The model ID does not appear in /v1/models. The silero-vad
# package bundles its weights, so nothing is downloaded at runtime (airgap-clean
# out of the box, unlike the gated diarize weights).
#
# Full-stack vad service runs on CPU (Silero gains nothing from CUDA):
# VAD_USE_ONNX=false                    # true runs the bundled ONNX graph
#
# VAD-only CPU stack (`make up-vad-only`):
# VAD_DEVICE=cpu                        # default cpu in vad-only
# VAD_HOST_PORT=8006                    # host publish port for dev override

# Speaker diarization (pyannote/speaker-diarization-3.1 via FastAPI).
# Routed by LiteLLM as a pass-through; clients POST multipart audio to
#   http://<router>:${ROUTER_HOST_PORT}/diarize
# with optional num_speakers / min_speakers / max_speakers form fields —
# no /v1 prefix, not OpenAI-shaped. The model ID does not appear in
# /v1/models.
#
# The pipeline weights are gated on the Hugging Face Hub: for the first
# download, temporarily set HF_HUB_OFFLINE=0 and TRANSFORMERS_OFFLINE=0
# plus HF_TOKEN, with access accepted for BOTH
# pyannote/speaker-diarization-3.1 AND pyannote/segmentation-3.0 (the
# wespeaker-voxceleb-resnet34-LM embedding repo is public and downloads
# alongside). After that, the default offline mode serves from the shared
# huggingface-cache volume.
#
# Full-stack diarize service (CUDA, routed by LiteLLM at /diarize):
# DIARIZE_CUDA_VISIBLE_DEVICES=0
# DIARIZE_DEVICE=cuda                   # cuda | cpu; default cuda in full stack
#
# Diarize-only CPU stack (`make up-diarize-only`):
# DIARIZE_DEVICE=cpu                    # default cpu in diarize-only
# DIARIZE_HOST_PORT=8004                # host publish port for dev override
#
# Clustering hyperparameter overrides (optional; unset → stock model defaults,
# byte-identical to before). Tune against labelled clips (see eval/ transcript
# metric) before setting. An unparseable value warns and is ignored, never
# crashing startup.
# DIARIZE_FB=0.4                        # community-1 PLDA weight — LOWER → MORE speakers; 0.4 validated best on real clips (eval/reports/2026-07-14-fb-realdata-validation.md)
# DIARIZE_FA=0.07                       # community-1 PLDA companion weight — leave at stock 0.07 (both directions measured worse)
# DIARIZE_CLUSTERING_THRESHOLD=         # 3.1 agglomerative threshold (INERT for community-1's PLDA clustering)
# DIARIZE_SEG_MIN_DURATION_OFF=         # segmentation min_duration_off override
#
# VAD gating (full stack: ON by default — compose points DIARIZE_VAD_URL at
# the vad service). Crops /diarize turns to the Silero speech timeline,
# dropping music/noise over-detected as speech (measured −35% false alarm /
# −12.5% DER; eval/reports/2026-07-11-false-alarm-vad-gating.md). Fail-open:
# an unreachable vad leaves turns ungated. Both composes hardcode-default the
# URL to their own alias (full stack: vad; diarize-only: vad-only — where any
# value set here is ignored, so one shared .env serves both shapes); gating
# engages wherever the vad service is co-deployed.
# DIARIZE_VAD_GATE=off                  # kill switch (URL stays set)
# DIARIZE_VAD_URL=http://vad:8000       # full-stack only; unset → compose default
# DIARIZE_VAD_THRESHOLD=0.4             # Silero threshold (stock 0.5 over-cuts speech)
# DIARIZE_VAD_PAD_MS=100                # padding forwarded as speech_pad_ms
# DIARIZE_VAD_TIMEOUT=30                # /vad request timeout, seconds

# Named Entity Recognition (GLiNER, zero-shot NER via Ray Serve).
# Default is the large v2.5 variant on CUDA. For CPU-only hosts, the
# medium variant is the better fit:
#   NER_MODEL=gliner-community/gliner_medium-v2.5
#   NER_DEVICE=cpu
# Routed by LiteLLM as a pass-through; clients POST to
#   http://<router>:${ROUTER_HOST_PORT}/gliner
# with body {"text", "labels", "threshold"} — no /v1 prefix, not OpenAI-
# shaped. The model ID does not appear in /v1/models.
#
# NER_CUDA_VISIBLE_DEVICES=0
# NER_DEVICE=cuda                       # cuda | cpu
# NER_DTYPE=bfloat16                    # bfloat16 | float16 | float32
# NER_NUM_REPLICAS=1
# NER_NUM_GPUS_PER_REPLICA=1            # Ray Serve resource request; gliner-only defaults to 0
# NER_NUM_CPUS_PER_REPLICA=1            # Ray Serve resource request
# NER_MAX_BATCH_SIZE=32
# NER_BATCH_WAIT_TIMEOUT_MS=10
# NER_TARGET_MEMORY_FRACTION=0.8        # share of device memory Ray Serve may use
# NER_QUANTIZATION=int8                 # leave unset for fp; or "int8"
# NER_ENABLE_FLASHDEBERTA=true          # speedup for DeBERTa-backed variants
# NER_ENABLE_SEQUENCE_PACKING=true
# NER_DISABLE_COMPILE=true              # set if torch.compile warmup is too slow
# NER_SHM_SIZE=3gb

# --- gliner self-heal watchdog (supervises gliner.serve; restarts the
# container when the Ray Serve deployment wedges, ray-project/ray#63862) ---
# NER_WATCHDOG_ENABLED=true            # false -> run gliner.serve directly (no watchdog)
# NER_WATCHDOG_GRACE_S=180             # readiness grace before arming (hard cap 2x)
# NER_WATCHDOG_INTERVAL_S=30           # probe interval
# NER_WATCHDOG_FAILURES=3              # consecutive failures before restart (~90s)
# NER_WATCHDOG_TIMEOUT_S=10            # per-probe timeout (a hang counts as failure)
# NER_WATCHDOG_WEBHOOK_URL=            # optional alert target (Slack-style {"text":...}); unset = log only
