INFERENCE_NETWORK=inference-net

# Service set (full stack, CUDA): leave unset for the core stack
# (chat, embed, rerank, ner). Set PROFILE=media to also start audio +
# translate. `make` reads this.
# PROFILE=media
#
# The NER-only stack (`make up-ner-only`, CPU-friendly) uses
# docker/compose.ner-only.yaml — a separate compose project that ignores
# PROFILE and the chat/embed/rerank/audio/translate model vars. Only the
# NER_* knobs below apply in that shape. Defaults for ner-only are
# NER_DEVICE=cpu and NER_MODEL=gliner-community/gliner_medium-v2.5.

OPENAI_API_KEY=sk-no-key-required
# OPENAI_API_KEY is also used as the LiteLLM master key that gates access
# to the router. Clients must present it as `Authorization: Bearer <key>`.
# ROUTER_HOST_PORT=9000

# Proxy bypass: comma-separated extra hostnames appended to NO_PROXY/no_proxy.
# Must start with a leading comma:
# EXTRA_NO_PROXY=,some-extra-host

# Model selection
TEXT_MODEL=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
VISION_MODEL=palmfuture/Qwen3.6-35B-A3B-GPTQ-Int4
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
NER_MODEL=gliner-community/gliner_large-v2.5
WHISPER_MODEL=openai/whisper-large-v3
TRANSLATE_MODEL=Infomaniak-AI/vllm-translategemma-4b-it

# Optional Hugging Face access / offline mode
# HF_TOKEN=hf_your_token_here
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# LiteLLM router
LITELLM_TRIM_MESSAGES=true

# Chat
# CHAT_CUDA_VISIBLE_DEVICES=0,1
# CHAT_TENSOR_PARALLEL_SIZE=2
# CHAT_GPU_MEMORY_UTILIZATION=0.55
# CHAT_MAX_MODEL_LEN=8192
# CHAT_MAX_NUM_SEQS=8
# CHAT_MAX_NUM_BATCHED_TOKENS=16384
# CHAT_ENFORCE_EAGER=true
# CHAT_ENABLE_PREFIX_CACHING=true
# CHAT_TEMPLATE_CONTENT_FORMAT=openai
# CHAT_DEFAULT_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
# CHAT_LIMIT_MM_PER_PROMPT={"image":4}
# CHAT_CPU_OFFLOAD_GB=4

# Dense / sparse embeddings
# EMBED_CUDA_VISIBLE_DEVICES=1
# EMBED_GPU_MEMORY_UTILIZATION=0.1
# EMBED_RUNNER=pooling
# EMBED_CONVERT=embed
# EMBED_HF_OVERRIDES={"architectures":["BgeM3EmbeddingModel"]}

# Rerank
# RERANK_CUDA_VISIBLE_DEVICES=1
# RERANK_GPU_MEMORY_UTILIZATION=0.1
# RERANK_RUNNER=pooling

# Named Entity Recognition (GLiNER, zero-shot NER via Ray Serve).
# Default is the large v2.5 variant on CUDA. For CPU-only hosts, the
# medium variant is the better fit:
#   NER_MODEL=gliner-community/gliner_medium-v2.5
#   NER_DEVICE=cpu
# Routed by LiteLLM as a pass-through; clients POST to
#   http://<router>:${ROUTER_HOST_PORT}/gliner
# with body {"text", "labels", "threshold"} — no /v1 prefix, not OpenAI-
# shaped. The model ID does not appear in /v1/models.
#
# NER_CUDA_VISIBLE_DEVICES=0
# NER_DEVICE=cuda                       # cuda | cpu
# NER_DTYPE=bfloat16                    # bfloat16 | float16 | float32
# NER_NUM_REPLICAS=1
# NER_NUM_GPUS_PER_REPLICA=1            # Ray Serve resource request; ner-only defaults to 0
# NER_NUM_CPUS_PER_REPLICA=1            # Ray Serve resource request
# NER_MAX_BATCH_SIZE=32
# NER_BATCH_WAIT_TIMEOUT_MS=10
# NER_TARGET_MEMORY_FRACTION=0.8        # share of device memory Ray Serve may use
# NER_QUANTIZATION=int8                 # leave unset for fp; or "int8"
# NER_ENABLE_FLASHDEBERTA=true          # speedup for DeBERTa-backed variants
# NER_ENABLE_SEQUENCE_PACKING=true
# NER_DISABLE_COMPILE=true              # set if torch.compile warmup is too slow
# NER_SHM_SIZE=3gb

# Audio / ASR
# AUDIO_CUDA_VISIBLE_DEVICES=0,1
# AUDIO_GPU_MEMORY_UTILIZATION=0.15
# VLLM_MAX_AUDIO_CLIP_FILESIZE_MB=200

# Translate
# TRANSLATE_MODEL defaults to Infomaniak-AI/vllm-translategemma-4b-it, a vLLM-
# compatible repackaging of google/translategemma-4b-it that fixes the RoPE
# config, EOS token, and replaces the custom source/target JSON params with
# an in-content delimiter format. The stock google/translategemma-*-it
# models cannot be served through a standard OpenAI chat client.
#
# Clients must wrap the text to translate using this delimiter format:
#   <<<source>>>{iso_src}<<<target>>>{iso_tgt}<<<text>>>{text_to_translate}
# e.g. "<<<source>>>en<<<target>>>de<<<text>>>Hello world"
# Language codes are ISO 639-1 (en, de, fr, ...) with optional regional
# variants (en_US, zh_CN). 55 languages are supported. The model is trained
# for a ~2K context window, hence TRANSLATE_MAX_MODEL_LEN=2048 by default.
#
# TRANSLATE_CUDA_VISIBLE_DEVICES=0
# TRANSLATE_TENSOR_PARALLEL_SIZE=1
# TRANSLATE_GPU_MEMORY_UTILIZATION=0.15
# TRANSLATE_MAX_MODEL_LEN=2048
# TRANSLATE_MAX_NUM_SEQS=8
# TRANSLATE_MAX_NUM_BATCHED_TOKENS=4096
# TRANSLATE_ENABLE_PREFIX_CACHING=true