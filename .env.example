# vllm-service — example configuration
#
# deploy's `make env` writes .env from this file and keeps it in step
# (by hand: cp .env.example .env).
#
#   KEY=value     set per host
#   # KEY=value   optional; the value shown is the default
#
# Tags, on the line above a setting:
#   [required]          must be set on every host
#   [secret]            never printed; your value never follows the example
#   [shared: M [KEY]]   same value as member M (its KEY); make env fills it
#   [dev]               read only by the dev overlay (make up-dev)
#
# The values shown are those of the full stack (docker/compose.yaml, CUDA).
# The CPU-only shapes read the same .env; where one starts with another
# default, or ignores a key, the prose above the setting says so.
#
# Keep a comment on its own line: after an empty value, Compose reads a
# trailing "# ..." as the value.
#
# The containers read this file only: a value exported in the shell that
# runs `make up` does not reach them. The exceptions, settings compose fills
# in itself (the router's OPENAI_API_KEY, the pass-through models and
# devices such as CLIP_MODEL or DIARIZE_DEVICE, the CPU shapes' models, the
# HF flags, the diarize gate, the topics limits and the host ports), are
# listed in docs/configuration.md, Shell precedence.

# =============================================================================
# Required
# =============================================================================

# The router's master key (LiteLLM's master_key): every client sends it as
# its Bearer token, and the router passes it on to the vLLM backends, whose
# --api-key it is too. The apps (docint, Nextext, translator,
# open-webui-service) hold the same value; make env copies it to them. Any
# string works, for example the output of `openssl rand -hex 32`. Compose
# does not start the full stack while it is empty. Set it here and do not
# export it in the shell that runs `make up`: an export would beat this file
# for the router only, and the backends would answer 401. The CPU-only
# shapes run no router and do not read it.
# [required] [secret] [shared: docint, Nextext, translator, open-webui-service]
OPENAI_API_KEY=

# =============================================================================
# Network & proxy
# =============================================================================

# The external network every shape joins; the apps reach the router there
# under the alias vllm-router, a CPU-only shape under its own name. `make
# network` creates inference-net; override this only if you renamed it.
# INFERENCE_NETWORK=inference-net

# Proxy bypass: appended to every container's NO_PROXY/no_proxy list. It
# must start with a comma, for example
#   EXTRA_NO_PROXY=,some-extra-host
# EXTRA_NO_PROXY=

# =============================================================================
# Inference
# =============================================================================

# --- Models ---

# The Hugging Face model id each backend serves. The router lists these four
# in /v1/models, and clients send the exact id in the request's model field.
# Router and backend read them from this file and fall back to the same
# defaults (the router's are in docker/router/defaults.env), so they agree.
# Switching TEXT_MODEL to another model family also needs its
# CHAT_TOOL_CALL_PARSER (vllm-service, Chat).
# TEXT_MODEL=Qwen/Qwen3.8-27B-FP8
# EMBED_MODEL=BAAI/bge-m3
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# WHISPER_MODEL=openai/whisper-large-v3

# The pass-through backends take no model field and are not in /v1/models.
# gliner-only serves the medium GLiNER variant by default:
#   NER_MODEL=gliner-community/gliner_medium-v2.5
# The diarization weights are gated (vllm-service, Diarization). VAD_MODEL
# is informational: the silero-vad package bundles one model.
# NER_MODEL=gliner-community/gliner_large-v2.5
# CLIP_MODEL=openai/clip-vit-base-patch32
# DIARIZE_MODEL=pyannote/speaker-diarization-community-1
# VAD_MODEL=silero_vad

# --- Model revisions ---

# The commit each model id above is loaded at, as recorded with the release
# (deploy's fetch-model.sh prints it as "Revision:"), as the full
# 40-character commit id. A service then loads exactly that commit and does
# not start if the cache lacks it; the router's audit events report it as
# ai.revision. Empty passes no revision, and the cache's refs/main is
# served. Change a revision together with its model
# (docs/configuration.md, Model revisions). gliner takes no revision.

# chat
# TEXT_MODEL_REVISION=

# embed, embed-sparse and embed-only
# EMBED_MODEL_REVISION=

# rerank and rerank-only
# RERANK_MODEL_REVISION=

# asr (the openai-whisper checkpoints of asr-only have no Hub revision)
# WHISPER_MODEL_REVISION=

# clip and clip-only
# CLIP_MODEL_REVISION=

# diarize and diarize-only
# DIARIZE_MODEL_REVISION=

# --- Hugging Face ---

# 1 serves every model from the shared huggingface-cache volume, with no
# download at runtime (airgap). To fill the cache on a networked host, set
# both to 0 for the first start, then back to 1.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# An access token, needed only to download gated weights (the pyannote
# diarization pipelines) while the two flags above are 0.
# [secret]
# HF_TOKEN=

# =============================================================================
# vllm-service
# =============================================================================

# The full stack (make up) runs every backend below behind the router. Each
# CPU-only shape (make up-<shape>; docs/deployment-shapes.md) runs one of
# them alone, with no router and no GPU, and reads only its own keys
# (gliner-only NER_*, rerank-only RERANK_*, clip-only CLIP_*, embed-only
# EMBED_*, diarize-only DIARIZE_*, asr-only WHISPER_MODEL, vad-only VAD_*,
# topics-only TOPICS_*), plus the HF flags and its host port.

# --- GPU layout ---

# Each GPU backend sees the GPUs its *_CUDA_VISIBLE_DEVICES lists. The vLLM
# backends claim their *_GPU_MEMORY_UTILIZATION share of each at startup;
# clip and diarize allocate as they go; gliner, started last, takes
# NER_TARGET_MEMORY_FRACTION of what is left. The defaults put everything
# on GPU 0. A host with two GPUs might spread them like this:
#   CHAT_CUDA_VISIBLE_DEVICES=0,1
#   CHAT_TENSOR_PARALLEL_SIZE=2
#   CHAT_GPU_MEMORY_UTILIZATION=0.55
#   CHAT_MAX_MODEL_LEN=40000
#   CHAT_MAX_NUM_BATCHED_TOKENS=4608
#   EMBED_CUDA_VISIBLE_DEVICES=1
#   EMBED_GPU_MEMORY_UTILIZATION=0.1
#   EMBED_SPARSE_GPU_MEMORY_UTILIZATION=0.1
#   RERANK_CUDA_VISIBLE_DEVICES=1
#   RERANK_GPU_MEMORY_UTILIZATION=0.1
#   ASR_CUDA_VISIBLE_DEVICES=0,1

# PyTorch's allocator setting for every vLLM backend (chat, embed,
# embed-sparse, rerank, asr). Expandable segments reduce fragmentation on a
# GPU shared with backends that allocate as they go (clip, diarize). An
# empty value keeps this default; expandable_segments:False turns it off.
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Chat ---

# The chat backend (vLLM, TEXT_MODEL): its GPUs, tensor parallelism and the
# share of each GPU's memory it claims at startup.
# CHAT_CUDA_VISIBLE_DEVICES=0
# CHAT_TENSOR_PARALLEL_SIZE=1
# CHAT_GPU_MEMORY_UTILIZATION=0.5

# The context length, the sequences served at once, and the tokens per
# scheduler step.
# CHAT_MAX_MODEL_LEN=8192
# CHAT_MAX_NUM_SEQS=8
# CHAT_MAX_NUM_BATCHED_TOKENS=16384

# Any value, even false, passes --enforce-eager (no CUDA graphs: less memory,
# slower); leave it commented to keep CUDA graphs. Prefix caching is on
# while the value is true.
# CHAT_ENFORCE_EAGER=
# CHAT_ENABLE_PREFIX_CACHING=true

# Tool calling (docs/configuration.md, Tool calling). Auto tool choice is on
# by default: without it vLLM answers a request that sends tools with HTTP
# 400; false turns it off. The parser must match TEXT_MODEL's tool-call
# format (the default model writes Qwen3 XML); an empty value passes no
# parser, which also turns tool calling off.
# CHAT_ENABLE_AUTO_TOOL_CHOICE=true
# CHAT_TOOL_CALL_PARSER=qwen3_xml

# Optional vLLM flags, each passed only when set: --reasoning-parser,
# --chat-template-content-format, --chat-template,
# --default-chat-template-kwargs, --limit-mm-per-prompt and
# --cpu-offload-gb. For example
#   CHAT_REASONING_PARSER=qwen3
#   CHAT_TEMPLATE_CONTENT_FORMAT=openai
#   CHAT_DEFAULT_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
#   CHAT_LIMIT_MM_PER_PROMPT={"image":4}
#   CHAT_CPU_OFFLOAD_GB=4
# CHAT_REASONING_PARSER=
# CHAT_TEMPLATE_CONTENT_FORMAT=
# CHAT_CHAT_TEMPLATE=
# CHAT_DEFAULT_CHAT_TEMPLATE_KWARGS=
# CHAT_LIMIT_MM_PER_PROMPT=
# CHAT_CPU_OFFLOAD_GB=

# A quantized KV cache, passed as --kv-cache-dtype. fp8 about halves the KV
# memory (up to twice the context or concurrency; a hybrid model quantizes
# only its attention layers' KV, and a live run measured 1.36x on one). fp8
# is e4m3 on CUDA; fp8_e5m2 trades precision for range and ignores scales.
# K/V scales load from the checkpoint when it has them, else 1.0: for the
# best fp8 accuracy serve a checkpoint with calibrated KV scales
# (llm-compressor). Works with prefix caching. Empty: full precision.
#   CHAT_KV_CACHE_DTYPE=fp8
# CHAT_KV_CACHE_DTYPE=

# Speculative decoding, as JSON passed to --speculative-config. Method mtp
# drafts with the model's own multi-token-prediction head (MTP-native
# checkpoints only, such as Qwen3.5/3.6 with mtp_num_hidden_layers in their
# config): about 1.5-2x decode throughput for about one more layer of
# weights and KV, with bitwise-identical output (rejected drafts are
# recomputed). Empty: no speculation.
#   CHAT_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":1}
# CHAT_SPECULATIVE_CONFIG=

# --- Embeddings ---

# embed serves dense embeddings (/v1/embeddings, by model field). Its twin
# embed-sparse runs the same EMBED_MODEL with the token_classify pooler for
# /pooling and /tokenize, since vLLM binds one pooling task per server. Both
# run on EMBED_CUDA_VISIBLE_DEVICES; each claims its own memory share.
# EMBED_CUDA_VISIBLE_DEVICES=0
# EMBED_GPU_MEMORY_UTILIZATION=0.15
# EMBED_SPARSE_GPU_MEMORY_UTILIZATION=0.10

# The vLLM runner and conversion of both, and the pooling task of embed,
# which has to be pinned since vLLM 0.20.
# EMBED_RUNNER=pooling
# EMBED_CONVERT=embed
# EMBED_POOLER_TASK=embed

# vLLM's --hf-overrides, as JSON. Empty: compose passes, for BAAI/bge-m3,
#   EMBED_HF_OVERRIDES={"architectures":["BgeM3EmbeddingModel"]}
# and nothing for any other model.
# EMBED_HF_OVERRIDES=

# embed-only only, which serves all three routes from one loaded model on
# the CPU. The token length every route truncates to, and the ceiling on one
# forward pass, counted as rows x longest row (a batch pads to its longest
# text). Both batch routes split their input under that ceiling, so a
# client's batch size does not decide how much work or memory one pass
# takes; raise it for throughput on a bigger host, lower it for a client
# with a tight timeout (docs/configuration.md, Embedding batch budget).
# EMBED_MAX_LENGTH=8192
# EMBED_MAX_BATCH_TOKENS=16384

# --- Rerank ---

# The vLLM rerank backend: its GPUs, memory share, runner and pooling task
# (pinned since vLLM 0.20).
# RERANK_CUDA_VISIBLE_DEVICES=0
# RERANK_GPU_MEMORY_UTILIZATION=0.15
# RERANK_RUNNER=pooling
# RERANK_POOLER_TASK=classify

# rerank-only only: true runs the model in fp16, rarely worth it on a CPU.
# RERANK_USE_FP16=false

# --- CLIP ---

# The CLIP image and text tower (FastAPI, routed at /clip/*). The device is
# cuda or cpu; clip-only pins cpu and ignores CLIP_DEVICE.
# CLIP_CUDA_VISIBLE_DEVICES=0
# CLIP_DEVICE=cuda

# --- ASR ---

# The Whisper backend (vLLM, WHISPER_MODEL). asr-only runs openai-whisper on
# the CPU instead and reads neither of these.
# renamed: AUDIO_CUDA_VISIBLE_DEVICES -> ASR_CUDA_VISIBLE_DEVICES
# ASR_CUDA_VISIBLE_DEVICES=0
# renamed: AUDIO_GPU_MEMORY_UTILIZATION -> ASR_GPU_MEMORY_UTILIZATION
# ASR_GPU_MEMORY_UTILIZATION=0.15

# vLLM's limits for one audio upload, under vLLM's own names: the file size
# in MB, and the decoded length in seconds (vLLM's default is 600). 0 turns
# the length check off, which lets a small compressed upload expand into
# tens of GB of PCM.
# VLLM_MAX_AUDIO_CLIP_FILESIZE_MB=200
# VLLM_MAX_AUDIO_DECODE_DURATION_S=14400

# --- VAD ---

# Silero voice activity detection (FastAPI, routed at /vad), on the CPU in
# every shape. true runs the bundled ONNX graph.
# VAD_USE_ONNX=false

# --- Topics ---

# The topic-model fit (FastAPI on the CPU, routed at /topics/fit). The
# caller sends the vectors, so nothing is embedded or downloaded.
#
# The largest request accepted, in points (413 above it). It also caps
# points x dimensions at 1024 times this value.
# TOPICS_MAX_POINTS=150000

# The container's memory limit. A fit measured 3.9 GB at 100k points of 1024
# dimensions with texts of about 2,000 characters (about 5.4 GB at 150k);
# more points, wider vectors and longer texts raise it. A request over the
# limit kills only the topics container, which restarts
# (docs/configuration.md, Topic-model fit limits).
# TOPICS_MEM_LIMIT=7g

# --- Diarization ---

# Speaker diarization (pyannote via FastAPI, routed at /diarize). The
# pipeline weights are gated on the Hugging Face Hub: for the first download
# set both HF flags to 0 and HF_TOKEN, with access accepted for the pipeline
# you run (the default community-1; for 3.1 both
# pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0). Offline
# mode then serves them from the cache (docs/deployment-shapes.md,
# Diarize-only). The device is cuda or cpu; diarize-only pins cpu and
# ignores DIARIZE_DEVICE.
# DIARIZE_CUDA_VISIBLE_DEVICES=0
# DIARIZE_DEVICE=cuda

# Clustering overrides, unset by default: the model's stock values apply
# (for community-1, Fb 0.8 and Fa 0.07). DIARIZE_FB is community-1's
# speaker granularity, lower finds more speakers; 0.4 measured best on real
# labelled clips (eval/reports/2026-07-14-fb-realdata-validation.md):
#   DIARIZE_FB=0.4
# Both directions of DIARIZE_FA measured worse than stock. The clustering
# threshold applies to the 3.1 pipeline only. Validate a value on labelled
# clips (eval/) first; an unparseable one is ignored with a warning.
# DIARIZE_FB=
# DIARIZE_FA=
# DIARIZE_CLUSTERING_THRESHOLD=
# DIARIZE_SEG_MIN_DURATION_OFF=

# VAD gating: /diarize crops its turns to the vad service's speech timeline,
# which drops music and noise taken for speech (measured -35% false alarm,
# -12.5% DER; eval/reports/2026-07-11-false-alarm-vad-gating.md). It fails
# open: an unreachable vad leaves the turns ungated. false, off, no or 0
# turns it off while the URL stays set. diarize-only pins the URL to
# vad-only and ignores DIARIZE_VAD_URL, so one .env serves both shapes. The
# Silero threshold (its stock 0.5 over-cuts speech), the padding in ms
# (passed as speech_pad_ms) and the /vad timeout in seconds follow.
# DIARIZE_VAD_GATE=true
# DIARIZE_VAD_URL=http://vad:8000
# DIARIZE_VAD_THRESHOLD=0.4
# DIARIZE_VAD_PAD_MS=100
# DIARIZE_VAD_TIMEOUT=30

# --- NER ---

# GLiNER zero-shot NER via Ray Serve (routed at /gliner). The device is cuda
# or cpu, the dtype bfloat16, float16 or float32. gliner-only, on the CPU,
# starts with other defaults:
#   NER_DEVICE=cpu
#   NER_DTYPE=float32
#   NER_MAX_BATCH_SIZE=8
#   NER_BATCH_WAIT_TIMEOUT_MS=50
#   NER_TARGET_MEMORY_FRACTION=0.5
#   NER_DISABLE_COMPILE=true
# NER_CUDA_VISIBLE_DEVICES=0
# NER_DEVICE=cuda
# NER_DTYPE=bfloat16
# NER_NUM_REPLICAS=1
# NER_MAX_BATCH_SIZE=32
# NER_BATCH_WAIT_TIMEOUT_MS=10

# The share of device memory Ray Serve may use (GPU layout, above).
# NER_TARGET_MEMORY_FRACTION=0.8

# Optional gliner.serve flags. Quantization, full stack only: empty runs
# full precision, for example
#   NER_QUANTIZATION=int8
# Set to true: FlashDeBERTa (faster DeBERTa-backed variants), sequence
# packing, and --no-compile (when torch.compile's warmup is too slow).
# NER_QUANTIZATION=
# NER_ENABLE_FLASHDEBERTA=false
# NER_ENABLE_SEQUENCE_PACKING=false
# NER_DISABLE_COMPILE=false

# gliner-only only: the Ray Serve resources per replica, and the /dev/shm
# size (Ray's object store wants at least 30% of host RAM there). The
# full-stack gliner passes neither replica flag and uses ipc: host, so the
# three do nothing there.
# NER_NUM_GPUS_PER_REPLICA=0
# NER_NUM_CPUS_PER_REPLICA=1
# NER_SHM_SIZE=3gb

# --- GLiNER watchdog ---

# The watchdog supervises gliner.serve: it probes POST /gliner and exits
# after NER_WATCHDOG_FAILURES failures in a row, so that the container
# restarts (the Ray Serve wedge, ray-project/ray#63862); false runs
# gliner.serve directly. It arms at the first good probe and waits for one
# at most twice the grace, else it exits too. Grace, probe interval and probe
# timeout are in seconds; a hung probe counts as a failure. An optional
# webhook receives a Slack-style {"text": ...} alert; empty only logs.
# NER_WATCHDOG_ENABLED=true
# NER_WATCHDOG_GRACE_S=180
# NER_WATCHDOG_INTERVAL_S=30
# NER_WATCHDOG_FAILURES=3
# NER_WATCHDOG_TIMEOUT_S=10
# NER_WATCHDOG_WEBHOOK_URL=

# Ray's node-memory kill threshold, a fraction of host RAM; full stack only.
# Raise it toward 0.98 on a RAM-tight host where Ray kills gliner replicas
# before the model has loaded.
# NER_RAY_MEMORY_THRESHOLD=0.95

# =============================================================================
# Audit & retention
# =============================================================================

# The router writes one ai_call event per model call (docs/audit.md). The
# call types to audit, comma-separated; empty audits all of them
# (completion, text_completion, embedding, rerank, transcription,
# pass_through_endpoint, ...). An unknown name stops the router.
# AUDIT_ROUTER_CALL_TYPES=

# The secret open-webui-service signs its user token with (its
# OPEN_WEBUI_FORWARD_JWT_SECRET; make env keeps the two equal). Set, the
# router records Open WebUI's user as the actor of its calls; unset, no user
# is named.
# [secret] [shared: open-webui-service OPEN_WEBUI_FORWARD_JWT_SECRET]
# AUDIT_OPENWEBUI_JWT_SECRET=

# =============================================================================
# Development only
# =============================================================================

# The host ports the dev overlays publish: the router's for make up-dev,
# and each CPU-only shape's for its make up-dev-<shape>.
# [dev]
# ROUTER_HOST_PORT=9000
# [dev]
# NER_HOST_PORT=8001
# [dev]
# RERANK_HOST_PORT=8002
# [dev]
# CLIP_HOST_PORT=8003
# [dev]
# DIARIZE_HOST_PORT=8004
# [dev]
# ASR_HOST_PORT=8005
# [dev]
# VAD_HOST_PORT=8006
# [dev]
# EMBED_HOST_PORT=8007
# [dev]
# TOPICS_HOST_PORT=8008

# --- Outside Docker only ---

# The device of the asr-only and vad servers. Compose pins cpu in every
# shape (the full-stack asr runs vLLM instead), so a value here applies
# only to a server run outside Docker.
# [dev]
# ASR_DEVICE=cpu
# [dev]
# VAD_DEVICE=cpu
