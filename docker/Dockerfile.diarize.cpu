FROM ghcr.io/astral-sh/uv:python3.11-trixie-slim@sha256:839b8b68a4bf47933fbd4e64f2550fc6f36d7e15aceca8b1cc7e1ade1eb2f1c5

# curl for the docker-compose /health probe; ffmpeg decodes arbitrary
# uploaded containers to 16 kHz mono PCM before the pyannote pipeline runs.
# No compiler: every package below ships a wheel for amd64 and arm64.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# The torch stack, pinned, from the dedicated CPU-only index (same approach as
# Dockerfile.gliner.cpu / Dockerfile.clip.cpu). torch and torchaudio are at the
# torch of the CUDA image's base (Dockerfile.diarize.cuda); torchaudio is
# added because pyannote.audio imports it. We never decode through it (audio
# arrives as a pre-decoded waveform dict and diarize_compat.py stubs the one
# removed probing API), so only importability matters.
#
# torchcodec, which pyannote.audio 4.x imports, is 0.13.0 here, not the 0.11.1
# of the CUDA image (0.11 is the torch-2.11 row of torchcodec's compatibility
# table, https://github.com/pytorch/torchcodec#installing-torchcodec). The CPU
# index has no 0.11 or 0.12 wheel for linux/arm64 (its arm64 wheels start at
# 0.13), and PyPI's arm64 0.11.1 is a CUDA-13 build that dlopens libnvrtc.so.13,
# which this image does not have. 0.13 is the nearest release with a CPU build
# for both amd64 and arm64, and the table lists it for torch >=2.11.
RUN uv pip install --system --no-cache --compile-bytecode \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.11.0 torchaudio==2.11.0 torchcodec==0.13.0

# The rest of the closure, from the lock (docker/diarize/uv.lock): pyannote.audio
# 4.0.7 and everything it, the server and the smoke test below import. The torch
# stack is installed above and is excluded from the lock, which is why this
# installs with --no-deps: the lock holds every other runtime dependency.
# --locked fails the build if the lock has drifted from docker/diarize/pyproject.toml,
# and --require-hashes checks each locked artifact against its hash. Every package
# ships a wheel, so nothing is compiled. (torch's own dependencies, sympy and the
# like, come with the torch install above, pinned only at the top level.)
# uv pip check then fails the build if a locked package needs another torch
# stack than the one pinned above (a bump of pyannote.audio, lightning or
# torchmetrics that wants a newer torch), which --no-deps would not notice.
# The build files are used from /build without making it the working directory,
# which stays the base image's.
COPY docker/diarize/pyproject.toml docker/diarize/uv.lock /build/
RUN cd /build \
    && uv export --locked --no-dev --no-emit-project --format requirements-txt -o /build/requirements.txt \
    && uv pip install --system --no-cache --no-deps --require-hashes --compile-bytecode \
        -r /build/requirements.txt \
    && uv pip check --system

# pyannote.audio 4.x sends usage telemetry (OpenTelemetry spans to
# otel.pyannote.ai: pipeline loads, every pipeline run with its audio duration
# and speaker counts, model inits) unless PYANNOTE_METRICS_ENABLED is false;
# the package defaults it to true. Nothing is fetched or sent at runtime, so it
# is off here, for the smoke test below and for the running container.
ENV PYANNOTE_METRICS_ENABLED=false

# Build-time smoke test (mirrors Dockerfile.diarize.cuda): fail the build, not
# the running container, on dependency drift. It needs no gated weights, so it
# stops short of Pipeline.from_pretrained and instantiation:
#   * imports: torch and torchcodec load (the pins above fit each other) and the
#     pyannote.audio import chain (lightning, pyannote.pipeline and its optuna,
#     ...) succeeds with diarize_compat applied, plus Audio construction.
#   * torch.load weights_only: round-trip the exact trusted checkpoint globals
#     through the weights_only=True loader. Catches a renamed symbol or a broken
#     allowlist here — instead of only on the first real Pipeline.from_pretrained
#     in production.
COPY src/diarize_compat.py /app/diarize_compat.py
COPY src/diarize_gate.py /app/diarize_gate.py
RUN PYTHONPATH=/app python -c "import tempfile, os, torch, torchcodec, diarize_compat; from diarize_gate import crop_turns_to_speech; from pyannote.audio import Pipeline; import pyannote.audio.pipelines; from pyannote.audio.core.io import Audio; Audio(sample_rate=16000); p = tempfile.NamedTemporaryFile(suffix='.ckpt', delete=False).name; torch.save({'g': list(diarize_compat.TRUSTED_CHECKPOINT_GLOBALS), 'w': torch.zeros(1)}, p); torch.load(p, weights_only=True); os.unlink(p); print('diarize build smoke: OK')"

COPY src/diarize_audio.py /app/diarize_audio.py
COPY src/diarize_pipeline.py /app/diarize_pipeline.py
COPY src/diarize_server.py /app/diarize_server.py

ENV TOKENIZERS_PARALLELISM=true

# Non-root runtime user (deploy ADR 0001). The HF model cache volume is
# mounted under /home/app/.cache (see compose); /app stays root-owned and
# read-only to the app user. HOME matters: HF cache resolution derives
# from it, and HF_HUB_CACHE pins it explicitly as belt-and-braces.
# Pre-create the cache tree app-owned: the volume mounts at
# /home/app/.cache/huggingface/hub, and if the parents are missing the
# daemon creates them root:root, leaving ~/.cache unwritable to app
# (e.g. flashinfer's import-time mkdir ~/.cache/flashinfer fails).
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --home-dir /home/app \
       --shell /usr/sbin/nologin app \
    && mkdir -p /home/app/.cache/huggingface/hub \
    && chown -R app:app /home/app/.cache
# The root filesystem is read-only at runtime and /tmp is the one writable path
# (compose mounts a volume there), so matplotlib (which pyannote.audio imports
# at load) and fontconfig keep their caches in it; unset, they fail to create
# ~/.config/matplotlib and report "No writable cache directories" at every start.
ENV HOME=/home/app \
    HF_HUB_CACHE=/home/app/.cache/huggingface/hub \
    MPLCONFIGDIR=/tmp/matplotlib \
    XDG_CACHE_HOME=/tmp/.cache

USER 10001:10001

EXPOSE 8000

CMD ["uvicorn", "--app-dir", "/app", "diarize_server:app", "--host", "0.0.0.0", "--port", "8000"]
