ARG PYTORCH_IMAGE=docker.io/pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime@sha256:eee11b3b3872a8c838e35ef48f08b2d5def2080902c7f666831310ca1a0ef2be

FROM ${PYTORCH_IMAGE}

# curl for the docker-compose /health probe; ffmpeg decodes arbitrary
# uploaded containers to 16 kHz mono PCM before the pyannote pipeline runs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# pyannote.audio 4.x for community-1 (the default model — see diarize_pipeline
# DEFAULT_MODEL): community-1 needs 4.x (it passes a `plda` kwarg 3.x rejects),
# and 4.x decodes via torchcodec instead of torchaudio. build_pipeline already
# handles 4.x's renamed auth kwarg (token=) and diarize_server extracts
# .speaker_diarization from 4.x's DiarizeOutput, so the huggingface_hub<1.0
# cap (needed only for pyannote 3.x's use_auth_token= call) is dropped.
# --break-system-packages required on PyTorch 2.11+ (Debian PEP 668).
# torchcodec must be the +cpu build from the PyTorch index: the plain PyPI
# wheels (0.12+) are built against CUDA 13 and dlopen libnvrtc.so.13, and the
# +cu128 build dlopens libnppicc.so.12 — neither lib exists in this pytorch
# `-runtime` base image (it ships only a CUDA subset, no NVRTC/NPP). The +cpu
# build links only torch + ffmpeg, which is all we use: diarize_audio decodes
# uploads via the ffmpeg CLI and pyannote only ever receives waveform dicts,
# so torchcodec's GPU decode path is never exercised. 0.11 is the torch-2.11
# row of torchcodec's compatibility table. Installed first (and pinned) so
# pyannote's own torchcodec>=0.7 dependency is already satisfied and pip
# doesn't pull the broken PyPI wheel. When bumping PYTORCH_IMAGE, re-pick the
# pin from https://github.com/pytorch/torchcodec#installing-torchcodec — the
# smoke test below fails the build on a mismatch.
RUN pip install --no-cache-dir --break-system-packages \
    --index-url https://download.pytorch.org/whl/cpu \
    'torchcodec==0.11.1' \
    && pip install --no-cache-dir --break-system-packages \
    'fastapi>=0.115.0' \
    'uvicorn[standard]>=0.32.0' \
    'python-multipart>=0.0.9' \
    'pydantic>=2.0' \
    'pyannote.audio>=4,<5' \
    'huggingface_hub>=0.30' \
    'requests>=2.31'

# Build-time smoke test — fail the build (not the running container) on a
# base-image bump that breaks either compatibility shim in diarize_compat.py:
#   * torchaudio: 2.9+ removed symbols pyannote 3.x imports — exercise the full
#     import chain (lightning, speechbrain, ...) plus Audio construction.
#   * torch.load weights_only: round-trip the exact trusted checkpoint globals
#     through the weights_only=True loader. Needs no gated weights, yet still
#     catches a renamed symbol or a broken allowlist here — instead of only on
#     the first real Pipeline.from_pretrained in production.
COPY src/diarize_compat.py /app/diarize_compat.py
COPY src/diarize_gate.py /app/diarize_gate.py
RUN PYTHONPATH=/app python -c "import tempfile, os, torch, torchcodec, diarize_compat; from diarize_gate import crop_turns_to_speech; from pyannote.audio import Pipeline; import pyannote.audio.pipelines; from pyannote.audio.core.io import Audio; Audio(sample_rate=16000, mono='downmix'); p = tempfile.NamedTemporaryFile(suffix='.ckpt', delete=False).name; torch.save({'g': list(diarize_compat.TRUSTED_CHECKPOINT_GLOBALS), 'w': torch.zeros(1)}, p); torch.load(p, weights_only=True); os.unlink(p); print('diarize build smoke: OK')"

COPY src/diarize_audio.py /app/diarize_audio.py
COPY src/diarize_pipeline.py /app/diarize_pipeline.py
COPY src/diarize_server.py /app/diarize_server.py

# Non-root runtime user (deploy ADR 0001). The HF model cache volume is
# mounted under /home/app/.cache (see compose); /app stays root-owned and
# read-only to the app user. HOME matters: HF cache resolution derives
# from it, and HF_HUB_CACHE pins it explicitly as belt-and-braces.
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --home-dir /home/app \
       --shell /usr/sbin/nologin app
ENV HOME=/home/app \
    HF_HUB_CACHE=/home/app/.cache/huggingface/hub

USER 10001:10001

EXPOSE 8000

CMD ["uvicorn", "--app-dir", "/app", "diarize_server:app", "--host", "0.0.0.0", "--port", "8000"]
