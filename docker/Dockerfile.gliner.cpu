ARG UV_IMAGE=ghcr.io/astral-sh/uv:python3.11-bookworm-slim@sha256:4f5d923c9dcea037f57bda425dd209f3ec643da2f0b74227f68d09dab0b3bb36

FROM ${UV_IMAGE}

# curl is needed for the docker-compose healthcheck against Ray Serve's
# /-/healthz endpoint. build-essential covers transitive deps that build
# from source on platforms without a prebuilt wheel.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# CPU-only PyTorch from the dedicated index. The default PyPI wheel for
# linux/amd64 pulls a CUDA build; pinning to the cpu index avoids that.
# linux/arm64 wheels at the same index are CPU-only by definition.
# uv pip install --system writes to the image's Python (the uv-managed
# standalone Python that ships with the astral/uv image); --compile-bytecode
# pre-compiles .pyc files to match pip's behavior so first-run import isn't
# slowed by JIT bytecode compilation.
RUN uv pip install --system --no-cache --compile-bytecode \
    --index-url https://download.pytorch.org/whl/cpu \
    torch

# Same pinned gliner.serve commit as Dockerfile.gliner.cuda so the request /
# response shape matches the CUDA variant. No torchao — int8 quantization
# is a GPU-only optimization that the CPU server does not use.
# Pin protobuf<7: Ray 2.55.1 under-constrains it (>=3.20.3) and its generated
# descriptors crash on protobuf 7.x, which dropped FieldDescriptor.label;
# protobuf<7 resolves 6.x, which still exposes .label. Same pin as the CUDA image.
RUN uv pip install --system --no-cache --compile-bytecode \
    'gliner[serve] @ https://github.com/urchade/GLiNER/archive/910a1aefb300f17bb67d31d4a92890c8d78aaa4b.tar.gz' \
    'protobuf<7'

# Force Ray Serve's HTTP proxy to bind 0.0.0.0 instead of the default
# 127.0.0.1. Upstream gliner.serve.server calls
#   ray_serve.start(detached=True, http_options={"port": config.http_port})
# with no host parameter, so the proxy is unreachable from sibling
# containers on the Docker network even when /-/healthz reports ready.
# There is no CLI flag or env var to override this upstream; we patch the
# installed file at build time. The assert makes the build fail loudly if
# upstream changes the line (so we notice when bumping the gliner pin).
RUN python -c "import gliner.serve.server, pathlib; p=pathlib.Path(gliner.serve.server.__file__); t=p.read_text(); m='http_options={\"port\": config.http_port}'; assert m in t, f'gliner.serve.server bind-host patch target not found in {p}'; p.write_text(t.replace(m, 'http_options={\"host\": \"0.0.0.0\", \"port\": config.http_port}'))"

# In-container self-heal watchdog: supervises gliner.serve and self-exits on a
# failed NER probe so the container restarts (clears the Ray Serve rank wedge,
# ray-project/ray#63862). See docs/superpowers/specs/2026-06-25-gliner-self-heal-watchdog-design.md
COPY scripts/gliner_watchdog.sh /usr/local/bin/gliner-watchdog
RUN chmod +x /usr/local/bin/gliner-watchdog && sh -n /usr/local/bin/gliner-watchdog

ENV TOKENIZERS_PARALLELISM=true

# Non-root runtime user (deploy ADR 0001). The HF model cache volume is
# mounted under /home/app/.cache (see compose); /app stays root-owned and
# read-only to the app user. HOME matters: HF cache resolution derives
# from it, and HF_HUB_CACHE pins it explicitly as belt-and-braces.
# Pre-create the cache tree app-owned: the volume mounts at
# /home/app/.cache/huggingface/hub, and if the parents are missing the
# daemon creates them root:root, leaving ~/.cache unwritable to app
# (e.g. flashinfer's import-time mkdir ~/.cache/flashinfer fails).
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --home-dir /home/app \
       --shell /usr/sbin/nologin app \
    && mkdir -p /home/app/.cache/huggingface/hub \
    && chown -R app:app /home/app/.cache
ENV HOME=/home/app \
    HF_HUB_CACHE=/home/app/.cache/huggingface/hub

USER 10001:10001

EXPOSE 8000
