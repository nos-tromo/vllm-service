ARG VLLM_OPENAI_IMAGE=docker.io/vllm/vllm-openai:v0.26.0@sha256:ffb2d59b1c059a5bd8d781320c9f5189de8293693b7d95da54befddaa54abf52

FROM ${VLLM_OPENAI_IMAGE}

# Add vLLM's audio extras (av, scipy, soundfile, mistral_common[audio]) plus
# orjson — vLLM's `ORJSONResponse` uses it opportunistically for faster
# OpenAI-endpoint serialization and falls back to stdlib json if absent.
RUN pip install --no-cache-dir 'vllm[audio]==0.26.0' orjson

# Non-root runtime user (deploy ADR 0001). The HF model cache volume is
# mounted under /home/app/.cache (see compose); /app stays root-owned and
# read-only to the app user. HOME matters: HF cache resolution derives
# from it, and HF_HUB_CACHE pins it explicitly as belt-and-braces.
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --home-dir /home/app \
       --shell /usr/sbin/nologin app
ENV HOME=/home/app \
    HF_HUB_CACHE=/home/app/.cache/huggingface/hub \
    VLLM_CACHE_ROOT=/home/app/.cache/vllm

USER 10001:10001
