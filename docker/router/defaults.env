# The router's defaults, read before the repo's .env (docker/compose.yaml,
# router env_file), which wins for every key it sets. They equal the defaults
# the backends start with, so a .env that leaves a key commented still routes
# to the model the backend serves. Env files only, as for the backends, so a
# value exported in the shell does not reach these keys. No secrets here; the
# master key comes from .env through the router's environment: entry.
TEXT_MODEL=Qwen/Qwen3.8-27B-FP8
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
WHISPER_MODEL=openai/whisper-large-v3
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
